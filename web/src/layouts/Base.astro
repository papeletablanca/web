---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/public-sans/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { ruta } from '../lib/datos';

interface Props {
  titulo?: string;
  descripcion?: string;
  /** Página incluida en el buscador */
  buscable?: boolean;
}
const {
  titulo,
  descripcion = 'Todo lo oficial sobre las elecciones generales del 29 de noviembre de 2026: calendario, candidaturas por provincia y novedades del BOE. Sin opiniones, siempre con la fuente.',
  buscable = false,
} = Astro.props;
const tituloCompleto = titulo ? `${titulo} · Papeleta Blanca` : 'Papeleta Blanca · elecciones generales del 29 de noviembre';

const menu = [
  ['', 'Portada'],
  ['formaciones', 'Formaciones'],
  ['provincias', 'Provincias'],
  ['boe', 'BOE'],
  ['como-votar', 'Cómo votar'],
  ['metodologia', 'Cómo funciona'],
  ['buscar', 'Buscar'],
] as const;
const actual = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').replace(/^\/|\/$/g, '').split('/')[0];
const activo = (p: string) => actual === p || (p === 'formaciones' && actual === 'formacion') || (p === 'provincias' && actual === 'provincia');
const canonica = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href={ruta('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Papeleta Blanca · novedades del BOE" href={ruta('feed.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Papeleta Blanca" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#fbfaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131210" media="(prefers-color-scheme: dark)" />
    <ClientRouter />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header>
      <div class="wrap barra">
        <a class="brand" href={ruta()}><b>Papeleta Blanca</b><span>generales · 29N 2026</span></a>
        <nav aria-label="Secciones">
          {menu.map(([p, texto]) => <a href={ruta(p)} aria-current={activo(p) ? 'page' : undefined}>{texto}</a>)}
        </nav>
      </div>
    </header>
    <main id="contenido" class="wrap" data-pagefind-body={buscable ? '' : undefined}>
      <slot />
    </main>
    <footer>
      <div class="wrap">
        <span>Papeleta Blanca · proyecto ciudadano independiente, sin vínculo con ningún partido, candidatura u orientación política, ni con el BOE. El nombre se refiere solo al color de la papeleta del Congreso: no promueve ninguna opción de voto, tampoco el voto en blanco. <a href={ruta('metodologia')}>Más información</a>.</span>
        <span>Datos: <a href="https://www.boe.es/datosabiertos/">BOE (datos abiertos)</a>, Real Decreto 806/2026, LOREG. <a href={ruta('feed.xml')}>RSS</a> · Textos <a href="https://creativecommons.org/licenses/by/4.0/deed.es">CC BY 4.0</a></span>
      </div>
    </footer>
  </body>
</html>

<style>
  .saltar { position: absolute; left: -9999px; }
  .saltar:focus { left: 16px; top: 16px; z-index: 20; background: var(--ink); color: var(--paper); padding: 8px 12px; border-radius: 6px; }
  body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 10; background: var(--paper); }
  header { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 5; background: color-mix(in srgb, var(--paper) 88%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .barra { display: flex; align-items: center; justify-content: space-between; gap: 8px 16px; padding-block: 12px; flex-wrap: wrap; }
  .brand { display: flex; align-items: baseline; gap: 8px; text-decoration: none; }
  .brand b { font: 800 1.35rem/1 var(--f-display); letter-spacing: -0.02em; }
  .brand span { font: 500 0.75rem var(--f-mono); color: var(--muted); }
  nav { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; max-width: 100%; }
  nav::-webkit-scrollbar { display: none; }
  nav a { text-decoration: none; font-size: 0.9rem; font-weight: 500; padding: 6px 12px; border-radius: 999px; color: var(--muted); white-space: nowrap; }
  nav a:hover { color: var(--ink); }
  nav a[aria-current="page"] { background: var(--ink); color: var(--paper); }
  footer { border-top: 1px solid var(--line); color: var(--muted); font-size: 0.85rem; }
  footer .wrap { padding-block: 24px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  @media (max-width: 720px) { .barra { flex-direction: column; align-items: stretch; } nav { margin-inline: -12px; } }
</style>
