---
import Base from '../../layouts/Base.astro';
import Termino from '../../components/Termino.astro';
import Dato from '../../components/Dato.astro';
import { getCollection } from 'astro:content';
import { candidaturasBoe, circunscripciones, coaliciones, coalicionesDe, corto, fichasDe, ruta, type Formacion } from '../../lib/datos';

export async function getStaticPaths() {
  return (await getCollection('formaciones')).map((f) => ({ params: { id: f.id }, props: { f } }));
}
const { f } = Astro.props as { f: Formacion };
const d = f.data;

const todas = await getCollection('formaciones');
const cand = await candidaturasBoe();
const provincias = await circunscripciones();
const coals = await coaliciones();
const enCoalicion = coalicionesDe(f, coals);
const FUENTE_COALICIONES = 'https://www.juntaelectoralcentral.es/cs/jec/elecciones/coalicionesJEC?fechaeleccion=2026-11-29&tipoeleccion=Elecciones%20Generales';
// Sus listas al Congreso: las que llevan sus siglas y las de las coaliciones de las que forma parte.
const suyas = (cand?.candidaturas ?? []).filter((c) => c.camara === 'congreso' && c.proclamada && fichasDe(c, todas, coals).some((x) => x.id === f.id));
const donde = provincias.filter((p) => suyas.some((c) => c.provincia === p.id));
// Quién encabeza la lista al Congreso en cada provincia: el primer candidato, tal como lo publica el BOE.
const cabezas = donde.map((p) => ({ p, nombre: suyas.find((c) => c.provincia === p.id)?.candidatos[0]?.nombre }));
const RESULTADOS_23J = 'https://www.boe.es/diario_boe/txt.php?id=BOE-A-2023-18907';
const tipo = d.tipo ? d.tipo.charAt(0).toUpperCase() + d.tipo.slice(1) : 'Formación política';
---

<Base titulo={d.nombre} descripcion={`Ficha de ${d.nombre} (${corto(f)}) para las elecciones generales del 29N: dónde se presenta, quién encabeza cada lista y su programa, con fuentes.`} buscable>
  <div class="page-head">
    <p class="label">Ficha de formación</p>
    <h1>{d.nombre}</h1>
    <p>
      {d.siglas.join(' · ')} · {tipo}
      {cand && <> · Se presenta en {donde.length} {donde.length === 1 ? 'circunscripción' : 'circunscripciones'}</>}
    </p>
  </div>

  <section>

    <div class="facts">
      <Dato etiqueta="Programa electoral" d={d.programa} enlace vacio="Sin publicar" />
      <Dato etiqueta="Web oficial" d={d.web} enlace />
      {d.escanos_23j && (
        <Dato
          etiqueta="Escaños en el Congreso el 23J de 2023"
          d={{ valor: `${d.escanos_23j.valor}${d.escanos_23j.nota ? ` (${d.escanos_23j.nota})` : ''}`, estado: 'confirmado', fuente: RESULTADOS_23J, fecha: new Date('2023-09-01') }}
        />
      )}
    </div>
  </section>

  {
    (d.integrantes.length > 0 || d.marcas_territoriales.length > 0) && (
      <section>
        <div class="sec-head"><h2>Composición</h2></div>
        {d.integrantes.length > 0 && <p>Integran la coalición: {d.integrantes.join(', ')}.</p>}
        {d.marcas_territoriales.length > 0 && (
          <ul class="marcas">
            {d.marcas_territoriales.map((m) => (
              <li><strong>{m.nombre}</strong> <span class="muted">· {m.ambito}{m.siglas.length > 0 && ` · ${m.siglas.join(', ')}`}</span></li>
            ))}
          </ul>
        )}
      </section>
    )
  }

  {
    enCoalicion.length > 0 && (
      <section>
        <div class="sec-head">
          <h2>En coalición</h2>
          <p>Coaliciones inscritas ante la Junta Electoral Central cuyo nombre o siglas oficiales incluyen las de {corto(f)}. Donde concurre en coalición, sus listas llevan el nombre de la coalición.</p>
        </div>
        <ul class="coaliciones">
          {enCoalicion.map((c) => (
            <li>
              <strong>{c.nombre}</strong> <span class="muted">Siglas: {c.siglas}</span>
              <span>{c.ambito}</span>
              {c.pacto && <a href={c.pacto} rel="noopener">Pacto de coalición (PDF)</a>}
            </li>
          ))}
        </ul>
        <p class="muted fuente">Fuente: <a href={FUENTE_COALICIONES}>Junta Electoral Central, coaliciones válidamente constituidas</a>.</p>
      </section>
    )
  }

  <section>
    <div class="sec-head">
      <h2>Dónde se presenta y quién encabeza la lista</h2>
      <p>En las generales no se vota a un presidente. En cada provincia se vota una <Termino id="lista-cerrada">lista cerrada</Termino> de candidatos al Congreso, y después el Congreso elige a quien preside el Gobierno.</p>
    </div>
    {
      cand ? (
        donde.length ? (
          <>
            <ul class="cabezas">
              {cabezas.map(({ p, nombre }) => (
                <li><a href={ruta(`provincia/${p.id}`)}>{p.data.nombre}</a><span>{nombre ?? 'Sin nombre en el BOE'}</span></li>
              ))}
            </ul>
            <p class="muted fuente">Listas al Congreso, primer nombre de cada una. Fuente: candidaturas {cand.fase}, <a href={cand.fuente.url}>{cand.fuente.id}</a>.</p>
          </>
        ) : (
          <div class="empty">No aparece con estas siglas ({d.siglas.join(', ')}) en las candidaturas {cand.fase} del <Termino id="boe" />.</div>
        )
      ) : (
        <div class="empty"><strong>Todavía no hay listas oficiales.</strong><span>Cuando el BOE publique las candidaturas (hacia el 28 de octubre), aquí aparecerá en qué provincias se presenta y quién encabeza cada lista.</span></div>
      )
    }
  </section>

  {
    d.redes.length > 0 && (
      <section>
        <div class="sec-head"><h2>Redes oficiales</h2></div>
        <div class="provlist">{d.redes.map((r) => <a href={r.url} rel="noopener">{r.red}</a>)}</div>
      </section>
    )
  }

  <section>
    <p class="muted por-que">Por qué tiene ficha: {d.inclusion.motivo} (<a href={d.inclusion.fuente}>fuente</a>). <a href={ruta('metodologia')}>Reglas de neutralidad</a>.</p>
  </section>
</Base>

<style>
  .facts { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 0 32px; }
  .cabezas { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 0 32px; }
  .cabezas li { display: flex; justify-content: space-between; gap: 4px 16px; flex-wrap: wrap; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .cabezas a { font-weight: 600; }
  .fuente { font-size: 0.85rem; }
  .provlist { display: flex; flex-wrap: wrap; gap: 6px; }
  .provlist a { font-size: 0.85rem; padding: 4px 10px; border: 1px solid var(--line); border-radius: 999px; text-decoration: none; background: var(--surface); }
  .provlist a:hover { border-color: var(--accent); }
  .marcas { padding-left: 1.2em; display: grid; gap: 6px; }
  .coaliciones { list-style: none; padding: 0; display: grid; gap: 0; }
  .coaliciones li { display: grid; gap: 4px; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 0.95rem; }
  .coaliciones a { justify-self: start; font-size: 0.88rem; font-weight: 600; }
  .por-que { font-size: 0.88rem; }
</style>
