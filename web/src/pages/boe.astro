---
import Base from '../layouts/Base.astro';
import TarjetaBoe from '../components/TarjetaBoe.astro';
import Termino from '../components/Termino.astro';
import { getCollection } from 'astro:content';
import { fecha, hallazgosBoe, plural, ruta } from '../lib/datos';

const hallazgos = await hallazgosBoe();
const dias = [...new Set(hallazgos.map((h) => h.fecha))];
const revisadas = (await getCollection('boe')).reduce((a, d) => a + d.data.disposiciones_revisadas, 0);
---

<Base titulo="Novedades oficiales" descripcion="Todo lo que publica el BOE sobre las elecciones generales del 29 de noviembre, día a día y con el enlace al original.">
  <div class="page-head">
    <p class="label">Novedades oficiales</p>
    <h1>Lo que publica el BOE sobre las elecciones</h1>
    <p>
      Cada mañana y cada tarde se revisa todo lo que publica el <Termino id="boe" /> y se apartan las disposiciones relacionadas con las elecciones.
      Llevamos {revisadas.toLocaleString('es-ES')} disposiciones revisadas y {plural(hallazgos.length, 'novedad', 'novedades')}.
      Síguelas por <a href={ruta('feed.xml')}>RSS</a>.
    </p>
  </div>
  {
    dias.map((d) => (
      <section>
        <h2 class="dia">{fecha(d, { weekday: 'long', day: 'numeric', month: 'long' })}</h2>
        <div class="cards">{hallazgos.filter((h) => h.fecha === d).map((h) => <TarjetaBoe h={h} completo />)}</div>
      </section>
    ))
  }
</Base>

<style>
  .dia { font-size: 1.2rem; }
  .dia::first-letter { text-transform: uppercase; }
</style>
