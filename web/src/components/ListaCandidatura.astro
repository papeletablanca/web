---
// Una candidatura del BOE, desplegable, con sus candidatos y suplentes.
import { corto, fichaDe, ruta, type Candidatura, type Formacion } from '../lib/datos';

// fichas: la de la formación, o las de las formaciones de la coalición que presenta la lista (fichasDe en lib/datos.ts)
interface Props { c: Candidatura; fichas: Formacion[]; abierta?: boolean }
const { c, fichas, abierta = false } = Astro.props;
const senado = c.camara === 'senado';
const fichaPropia = fichaDe(c, fichas);  // la lista lleva las siglas de la propia ficha, sin coalición de por medio
---

<details open={abierta || undefined} class:list={{ fuera: !c.proclamada }}>
  <summary>
    <span class="n num">{c.orden}</span>
    <span class="s">{c.nombre}{c.siglas && <span class="siglas"> ({c.siglas})</span>}</span>
    <span class="c num">{c.proclamada ? `${c.candidatos.length} ${senado ? 'candidatos' : 'titulares'}` : 'no proclamada'}</span>
  </summary>
  <div class="cuerpo">
    {fichas.length === 1 && !fichaPropia ? (
      <p class="ficha">En coalición: <a href={ruta(`formacion/${fichas[0].id}`)}>ficha de {corto(fichas[0])} →</a></p>
    ) : fichas.length === 1 ? (
      <a class="ficha" href={ruta(`formacion/${fichas[0].id}`)}>Ficha de {corto(fichas[0])} →</a>
    ) : fichas.length > 1 ? (
      <p class="ficha">En coalición: {fichas.map((f, i) => <>{i > 0 && ' · '}<a href={ruta(`formacion/${f.id}`)}>ficha de {corto(f)} →</a></>)}</p>
    ) : (
      <span class="ficha muted">Sin ficha todavía</span>
    )}
    {c.candidatos.length > 0 && (
      <ol>
        {c.candidatos.map((p) => (
          <li>
            {p.nombre}
            {senado && p.suplentes && p.suplentes.length > 0 && <span class="sup">Suplentes: {p.suplentes.join(' · ')}</span>}
          </li>
        ))}
      </ol>
    )}
    {c.suplentes.length > 0 && (
      <>
        <p class="label">Suplentes</p>
        <ol class="suplentes">{c.suplentes.map((s) => <li>{s}</li>)}</ol>
      </>
    )}
  </div>
</details>

<style>
  details { border-top: 1px solid var(--line); }
  details:last-of-type { border-bottom: 1px solid var(--line); }
  summary { list-style: none; cursor: pointer; padding: 14px 0; display: flex; gap: 12px; align-items: baseline; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; font: 500 1.1rem var(--f-mono); color: var(--muted); }
  details[open] summary::after { content: "−"; }
  .n { font: 500 0.8rem var(--f-mono); color: var(--muted); min-width: 2ch; }
  .s { font-weight: 700; min-width: 0; overflow-wrap: anywhere; }
  .siglas { font-weight: 500; color: var(--muted); }
  .c { margin-left: auto; font: 400 0.75rem var(--f-mono); color: var(--muted); white-space: nowrap; }
  .fuera .s { color: var(--muted); text-decoration: line-through; text-decoration-thickness: 1px; }
  .cuerpo { display: grid; gap: 12px; padding: 0 0 18px 2.4em; }
  .ficha { font-size: 0.88rem; font-weight: 600; }
  ol { padding-left: 1.6em; columns: 2; column-gap: 32px; font-size: 0.92rem; }
  li { break-inside: avoid; padding-block: 2px; }
  .sup { display: block; font-size: 0.8rem; color: var(--muted); }
  .suplentes { color: var(--muted); }
  @media (max-width: 640px) { ol { columns: 1; } .cuerpo { padding-left: 0; } }
</style>
