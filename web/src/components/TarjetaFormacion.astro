---
import { corto, progreso, ruta, type Formacion } from '../lib/datos';

interface Props { f: Formacion }
const { f } = Astro.props;
const { conFuente, total } = progreso(f);
---

<a class="party" href={ruta(`formacion/${f.id}`)}>
  <span class="sig">{corto(f)}</span>
  <span class="name">{f.data.nombre}</span>
  {
    conFuente === 0 ? (
      <span class="chip pendiente">ficha en preparación</span>
    ) : (
      <span class="chip anunciado">{conFuente} de {total} datos con fuente</span>
    )
  }
</a>

<style>
  .party { border-top: 2px solid var(--ink); padding: 12px 0 0; display: grid; gap: 6px; text-decoration: none; align-content: start; }
  .party:hover .sig { color: var(--accent); }
  .sig { font: 800 1.35rem/1 var(--f-display); letter-spacing: -0.01em; transition: color 0.15s; }
  .name { font-size: 0.88rem; color: var(--muted); min-height: 2.6em; }
</style>
