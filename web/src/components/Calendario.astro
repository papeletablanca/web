---
import { getCollection } from 'astro:content';
import { fecha } from '../lib/datos';

const eventos = (await getCollection('calendario')).sort((a, b) => a.data.fecha.getTime() - b.data.fecha.getTime());
---

<div class="tl-scroll">
  <ol class="timeline" data-calendario>
    {
      eventos.map(({ data: e }) => (
        <li class:list={{ key: e.destacada }} data-fecha={e.fecha.toISOString().slice(0, 10)}>
          <span class="date num">{fecha(e.fecha)}</span>
          <span class="what">{e.fuente ? <a href={e.fuente}>{e.texto}</a> : e.texto}</span>
          {e.aproximada && <span class="approx">aprox.</span>}
        </li>
      ))
    }
  </ol>
</div>

<script>
  // Marca lo ya pasado y pone la etiqueta "hoy" antes del siguiente evento (hora peninsular).
  function marcar() {
    const hoy = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Madrid' });
    document.querySelectorAll<HTMLElement>('[data-calendario] li').forEach((li) => li.classList.remove('past', 'today-mark'));
    let marcado = false;
    document.querySelectorAll<HTMLElement>('[data-calendario] li').forEach((li) => {
      const f = li.dataset.fecha!;
      if (f < hoy) li.classList.add('past');
      else if (!marcado) {
        li.classList.add('today-mark');
        marcado = true;
      }
    });
  }
  document.addEventListener('astro:page-load', marcar);
</script>

<style>
  .tl-scroll { overflow-x: auto; padding-top: 30px; }
  .timeline { list-style: none; margin: 0; padding: 0; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); border-top: 2px solid var(--ink); }
  li { position: relative; padding: 14px 10px 4px 0; display: grid; gap: 4px; align-content: start; }
  li::before { content: ""; position: absolute; top: -7px; left: 0; width: 12px; height: 12px; border-radius: 50%; background: var(--paper); border: 2px solid var(--ink); }
  li.past::before { background: var(--ink); }
  li.today-mark::after { content: "hoy"; position: absolute; top: -30px; left: -6px; font: 600 0.7rem var(--f-mono); background: var(--accent); color: var(--paper); padding: 2px 6px; border-radius: 4px; }
  .date { font: 700 1rem var(--f-display); }
  .key .date { font-size: 1.25rem; }
  .what { font-size: 0.85rem; line-height: 1.35; }
  .what a { text-decoration: none; }
  .what a:hover { text-decoration: underline; }
  .past .what { color: var(--muted); }
  .approx { font: 500 0.68rem var(--f-mono); color: var(--muted); }
  @media (max-width: 820px) { .timeline { grid-auto-columns: 150px; } }
</style>
