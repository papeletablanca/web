---
// «Así es tu papeleta»: las dos papeletas de una circunscripción para practicar, sin enviar nada a ningún sitio.
// Congreso: una papeleta blanca por candidatura (lista cerrada; se elige una). Senado: una papeleta sepia por
// circunscripción (o por isla) con casillas; si se marcan más nombres de los permitidos el voto sería nulo.
// Sin candidaturas del BOE, enseña un ejemplo rotulado como tal, con nombres inventados.
import Termino from './Termino.astro';
import { marcasSenado, plural, type Candidatura, type Circunscripcion } from '../lib/datos';

// El BOE puede nombrar una isla en catalán y nuestros datos en castellano: se comparan sin tildes y con alias
const ALIAS: Record<string, string> = { eivissa: 'ibiza' };
const claveIsla = (s: string) => { const k = s.normalize('NFKD').replace(/[̀-ͯ]/g, '').toLowerCase().trim(); return ALIAS[k] ?? k; };
const mismaIsla = (a: string | null, b: string | null) => a !== null && b !== null && claveIsla(a) === claveIsla(b);

interface Props { p: Circunscripcion; candidaturas: Candidatura[] | null; fase?: string }
const { p, candidaturas, fase } = Astro.props;
const d = p.data;
const ejemplo = !candidaturas || candidaturas.length === 0;

// Ejemplo neutro: letras y números, nunca nombres de partidos reales
const inventadas = (camara: 'congreso' | 'senado', n: number, isla: string | null = null): Candidatura[] =>
  ['A', 'B', 'C'].map((letra, i) => ({
    provincia: p.id, camara, isla, orden: i + 1, nombre: `Candidatura ${letra}`, siglas: letra, proclamada: true,
    candidatos: [...Array(n)].map((_, k) => ({ nombre: `Persona ${letra}${k + 1}` })), suplentes: [],
  }));

const congreso = ejemplo ? inventadas('congreso', d.diputados) : candidaturas.filter((c) => c.camara === 'congreso' && c.proclamada);
const islas = d.senado_islas.length ? d.senado_islas.map((i) => ({ nombre: i.isla, senadores: i.senadores })) : [{ nombre: null, senadores: d.senadores }];
const senado = islas.map((isla) => ({
  ...isla,
  max: marcasSenado(isla.senadores),
  listas: ejemplo
    ? inventadas('senado', Math.min(3, isla.senadores), isla.nombre)
    : candidaturas.filter((c) => c.camara === 'senado' && c.proclamada && (isla.nombre === null || mismaIsla(c.isla, isla.nombre))),
}));
const uid = `pap-${p.id}`;
---

<section class="papeleta" id="papeleta" data-papeleta>
  <div class="sec-head">
    <h2>Así es tu papeleta</h2>
    <p>Practica aquí cómo se vota en {d.nombre}. No se guarda ni se envía nada.</p>
  </div>
  {
    ejemplo ? (
      <p class="aviso"><strong>Ejemplo con nombres inventados.</strong> Los nombres reales aparecerán cuando el BOE publique las candidaturas (hacia el 28 de octubre).</p>
    ) : (
      fase === 'presentadas' && <p class="aviso">Son las candidaturas <strong>presentadas</strong>: todavía pueden cambiar hasta la proclamación.</p>
    )
  }

  <div class="dos">
    <fieldset class="camara" data-congreso>
      <legend><h3>Congreso · papeleta blanca</h3></legend>
      <p class="explica">Cada candidatura tiene su propia papeleta. Elige una y métela en el sobre blanco. Es una <Termino id="lista-cerrada">lista cerrada</Termino>: no se tachan ni se añaden nombres.</p>
      <div class="opciones">
        {
          congreso.map((c, i) => (
            <label class="opcion">
              <input type="radio" name={`${uid}-congreso`} value={String(i)} />
              <span>{c.nombre}{c.siglas && c.siglas !== c.nombre && <span class="siglas"> ({c.siglas})</span>}</span>
            </label>
          ))
        }
      </div>
      <div class="hoja blanca" data-hoja-vacia>
        <p class="vacia">Elige una candidatura para ver su papeleta. Si metes el sobre vacío, es un <Termino id="voto-blanco">voto en blanco</Termino>.</p>
      </div>
      {
        congreso.map((c, i) => (
          <div class="hoja blanca" data-hoja={String(i)} hidden>
            <p class="cab">Elecciones al Congreso · {d.nombre}</p>
            <p class="lista">{c.nombre}</p>
            <ol>{c.candidatos.map((x) => <li>{x.nombre}</li>)}</ol>
            {c.suplentes.length > 0 && <p class="sup">Suplentes: {c.suplentes.join(' · ')}</p>}
          </div>
        ))
      }
    </fieldset>

    <div class="camara" data-senado>
      <h3>Senado · papeleta sepia</h3>
      <p class="explica">Una sola papeleta con todos los nombres: marca a las personas que quieras votar, de la misma candidatura o de varias. <Termino id="voto-senado">¿Cuántas?</Termino></p>
      {
        senado.length > 1 && (
          <label class="isla-elige">
            <span>¿En qué isla votas?</span>
            <select data-isla>{senado.map((s, i) => <option value={String(i)}>{s.nombre}</option>)}</select>
          </label>
        )
      }
      {
        senado.map((s, i) => (
          <fieldset class="hoja sepia" data-hoja-senado={String(i)} data-max={String(s.max)} hidden={i > 0}>
            <legend class="cab">Elecciones al Senado · {s.nombre ?? d.nombre} · marca hasta {s.max}</legend>
            <p class="cuenta" aria-live="polite" data-cuenta>No has marcado a nadie: sería un voto en blanco.</p>
            {s.listas.length === 0 && <p class="vacia">No hay candidaturas proclamadas en esta circunscripción.</p>}
            {s.listas.map((c) => (
              <div class="grupo">
                <p class="lista">{c.nombre}</p>
                {c.candidatos.map((x) => (
                  <label class="marca">
                    <input type="checkbox" />
                    <span>{x.nombre}</span>
                  </label>
                ))}
              </div>
            ))}
          </fieldset>
        ))
      }
    </div>
  </div>
  <p class="pie-papeleta">Fuente: LOREG, <a href="https://www.boe.es/buscar/act.php?id=BOE-A-1985-11672#anoventayseis">artículo 96</a> (votos nulos y en blanco) y <a href="https://www.boe.es/buscar/act.php?id=BOE-A-1985-11672#acientosesentayseis">artículo 166</a> (cuántos senadores se marcan). {plural(d.diputados, 'diputado', 'diputados')} y {plural(d.senadores, 'senador', 'senadores')} en juego en {d.nombre}.</p>
</section>

<script>
  function iniciar() {
    document.querySelectorAll<HTMLElement>('[data-papeleta]').forEach((pap) => {
      // Congreso: enseñar la papeleta elegida
      const congreso = pap.querySelector<HTMLElement>('[data-congreso]')!;
      congreso.addEventListener('change', (e) => {
        const valor = (e.target as HTMLInputElement).value;
        congreso.querySelectorAll<HTMLElement>('[data-hoja]').forEach((h) => (h.hidden = h.dataset.hoja !== valor));
        congreso.querySelector<HTMLElement>('[data-hoja-vacia]')!.hidden = true;
      });

      // Senado: elegir isla y contar marcas
      const hojas = [...pap.querySelectorAll<HTMLElement>('[data-hoja-senado]')];
      pap.querySelector<HTMLSelectElement>('[data-isla]')?.addEventListener('change', (e) => {
        const valor = (e.target as HTMLSelectElement).value;
        hojas.forEach((h) => (h.hidden = h.dataset.hojaSenado !== valor));
      });
      hojas.forEach((hoja) => {
        const max = Number(hoja.dataset.max);
        const cuenta = hoja.querySelector<HTMLElement>('[data-cuenta]')!;
        hoja.addEventListener('change', () => {
          const n = hoja.querySelectorAll('input:checked').length;
          hoja.classList.toggle('nulo', n > max);
          cuenta.textContent =
            n === 0 ? 'No has marcado a nadie: sería un voto en blanco.'
            : n > max ? `⚠ Has marcado ${n} y el máximo es ${max}: este voto sería nulo.`
            : `Has marcado ${n} de un máximo de ${max}. Voto válido.`;
        });
      });
    });
  }
  document.addEventListener('astro:page-load', iniciar);
</script>

<style>
  .papeleta { gap: 16px; scroll-margin-top: 90px; }
  .dos { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px; align-items: start; }
  .camara { display: grid; gap: 12px; border: 0; margin: 0; padding: 0; min-width: 0; }
  .camara legend { padding: 0; margin-bottom: 4px; }
  h3 { font-size: 1.15rem; }
  .explica { color: var(--muted); }
  .opciones { display: grid; gap: 6px; max-height: 18rem; overflow-y: auto; padding: 2px; }
  .opcion { display: flex; gap: 10px; align-items: baseline; padding: 8px 10px; border: 1px solid var(--line); border-radius: 8px; cursor: pointer; font-size: 0.92rem; }
  .opcion:has(input:checked) { border-color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); font-weight: 600; }
  .opcion input { flex: none; accent-color: var(--ink); }
  .siglas { color: var(--muted); font-weight: 400; }
  .hoja { border: 1px solid var(--line); border-radius: 6px; padding: 18px; display: grid; gap: 8px; align-content: start; box-shadow: 0 12px 24px -18px rgba(0, 0, 0, 0.35); margin: 0; min-width: 0; }
  .hoja[hidden] { display: none; }
  .blanca { background: var(--surface); }
  .sepia { background: var(--sepia); color: var(--sepia-ink); }
  .cab { font: 500 0.72rem/1.3 var(--f-mono); letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.85; padding: 0; }
  .sepia legend.cab { float: left; width: 100%; margin-bottom: 4px; }
  .lista { font: 700 1rem/1.25 var(--f-display); }
  .hoja ol { padding-left: 1.6em; font-size: 0.9rem; columns: 2; column-gap: 24px; }
  .sup { font-size: 0.8rem; color: var(--muted); }
  .vacia { color: var(--muted); font-size: 0.92rem; }
  .grupo { display: grid; gap: 4px; padding-top: 8px; border-top: 1px solid color-mix(in srgb, currentColor 20%, transparent); }
  .marca { display: flex; gap: 10px; align-items: center; font-size: 0.92rem; cursor: pointer; }
  .marca input { width: 20px; height: 20px; margin: 0; flex: none; accent-color: var(--sepia-ink); }
  /* El contador se queda a la vista mientras se baja por una papeleta larga */
  .cuenta { font-weight: 600; position: sticky; top: 80px; z-index: 1; background: var(--sepia); padding: 8px 0; margin: 0 0 4px; border-bottom: 1px solid color-mix(in srgb, currentColor 25%, transparent); }
  .nulo { outline: 3px dashed var(--sepia-ink); outline-offset: 3px; }
  .isla-elige { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; font-weight: 600; }
  .isla-elige select { font: 500 1rem var(--f-body); color: var(--ink); background: var(--paper); border: 2px solid var(--ink); border-radius: 8px; padding: 8px 10px; }
  .pie-papeleta { font-size: 0.85rem; color: var(--muted); }
  @media (max-width: 820px) { .dos { grid-template-columns: minmax(0, 1fr); } .hoja ol { columns: 1; } }
  @media (max-width: 720px) { .cuenta { top: 116px; } }  /* en el móvil la cabecera ocupa dos filas */
</style>
