---
// Mapa de casillas (una por circunscripción, colocadas a grandes rasgos como en el mapa)
// y hemiciclo de 350 puntos. Al pasar por una provincia se iluminan sus escaños.
import { circunscripciones, plural, ruta } from '../lib/datos';

const lista = await circunscripciones();
const maxDip = Math.max(...lista.map((c) => c.data.diputados));
const filas = Math.max(...lista.map((c) => c.data.mapa.fila)) + 1;

// Hemiciclo: filas concéntricas con escaños proporcionales al radio; se asignan de oeste a este.
const N = 350, nFilas = 9, r0 = 0.36, r1 = 1;
const radios = [...Array(nFilas)].map((_, i) => r0 + ((r1 - r0) * i) / (nFilas - 1));
const sumaR = radios.reduce((a, b) => a + b, 0);
const cupos = radios.map((r) => Math.round((N * r) / sumaR));
cupos[nFilas - 1] += N - cupos.reduce((a, b) => a + b, 0);
const asientos = radios
  .flatMap((r, i) => [...Array(cupos[i])].map((_, k) => { const a = Math.PI * (1 - k / (cupos[i] - 1)); return { a, x: r * Math.cos(a), y: -r * Math.sin(a), prov: '' }; }))
  .sort((s, t) => t.a - s.a);
let i = 0;
for (const c of [...lista].sort((a, b) => a.data.mapa.columna - b.data.mapa.columna || a.data.mapa.fila - b.data.mapa.fila)) {
  for (let k = 0; k < c.data.diputados; k++) asientos[i++].prov = c.id;
}
---

<div class="seats" data-mapa>
  <div>
    <ul class="tilemap" style={`grid-template-rows: repeat(${filas}, auto)`}>
      {
        lista.map((c) => {
          // Intensidad entre --tile-0 y --tile-1 (los dos colores garantizan contraste 4,5:1 con el texto en todos los temas)
          const w = Math.round(100 * Math.sqrt(c.data.diputados / maxDip));
          return (
            <li>
              <a
                class="tile"
                style={`--w:${w}%;grid-column:${c.data.mapa.columna + 1};grid-row:${c.data.mapa.fila + 1}`}
                href={ruta(`provincia/${c.id}`)}
                data-id={c.id}
                data-info={`${c.data.nombre}|${plural(c.data.diputados, 'diputado', 'diputados')} · ${plural(c.data.senadores, 'senador', 'senadores')}`}
                aria-label={`${c.data.nombre}: ${plural(c.data.diputados, 'diputado', 'diputados')}`}
              >
                {c.data.abreviatura}<b class="num">{c.data.diputados}</b>
              </a>
            </li>
          );
        })
      }
    </ul>
    <p class="mapinfo" aria-live="polite" data-mapinfo>Pasa por encima de una provincia o tócala.</p>
  </div>
  <div class="hemi">
    <svg viewBox="-1.06 -1.06 2.12 1.1" role="img" aria-label="Los 350 escaños del Congreso">
      {asientos.map((s) => <circle cx={s.x.toFixed(4)} cy={s.y.toFixed(4)} r="0.03" data-prov={s.prov} />)}
    </svg>
    <p class="total"><strong class="num">350</strong><br /><span class="label">escaños · mayoría absoluta 176</span></p>
  </div>
</div>

<script>
  function iniciar() {
    document.querySelectorAll<HTMLElement>('[data-mapa]').forEach((mapa) => {
      const info = mapa.querySelector<HTMLElement>('[data-mapinfo]')!;
      const textoInicial = info.textContent;
      const enfocar = (t: HTMLElement | null) => {
        const id = t?.dataset.id ?? null;
        mapa.querySelectorAll('circle').forEach((c) => c.classList.toggle('on', c.dataset.prov === id));
        mapa.querySelectorAll('.tile').forEach((x) => x.classList.toggle('on', x === t));
        if (!t) { info.textContent = textoInicial; return; }
        const [nombre, detalle] = t.dataset.info!.split('|');
        info.innerHTML = '';
        const s = document.createElement('strong');
        s.textContent = nombre;
        info.append(s, document.createElement('br'), detalle);
      };
      mapa.querySelectorAll<HTMLElement>('.tile').forEach((t) => {
        t.addEventListener('mouseenter', () => enfocar(t));
        t.addEventListener('focus', () => enfocar(t));
        t.addEventListener('mouseleave', () => enfocar(null));
        t.addEventListener('blur', () => enfocar(null));
      });
    });
  }
  document.addEventListener('astro:page-load', iniciar);
</script>

<style>
  .seats { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 32px; align-items: start; }
  .tilemap { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 4px; max-width: 520px; }
  .tilemap li { display: contents; }
  .tile { aspect-ratio: 1; border-radius: 6px; display: grid; place-items: center; align-content: center; text-decoration: none; font: 600 0.62rem/1 var(--f-mono); color: var(--ink); background: color-mix(in srgb, var(--tile-1) var(--w), var(--tile-0)); transition: transform 0.12s, box-shadow 0.12s; }
  .tile b { display: block; font: 700 0.82rem/1 var(--f-display); margin-top: 2px; }
  .tile:hover, .tile:focus-visible, .tile.on { transform: scale(1.12); box-shadow: 0 0 0 2px var(--ink); position: relative; z-index: 1; }
  .mapinfo { min-height: 3.2em; margin-top: 12px; font-size: 0.95rem; }
  .mapinfo :global(strong) { font-family: var(--f-display); font-size: 1.15rem; }
  .hemi svg { width: 100%; height: auto; display: block; }
  .hemi circle { fill: color-mix(in srgb, var(--ink) 22%, var(--paper)); transition: fill 0.15s; }
  .hemi circle.on { fill: var(--accent); }
  .total { text-align: center; margin-top: -8px; }
  .total strong { font: 800 2.2rem/1 var(--f-display); }
  @media (max-width: 820px) { .seats { grid-template-columns: minmax(0, 1fr); } }
</style>
